MEDIAMTX_PATH=.tools/mediamtx/mediamtx.exe
BANDWIDTH_TEST_MAX_SECONDS=10
BANDWIDTH_TEST_MAX_BYTES=52428800
BANDWIDTH_TEST_MAX_CONCURRENT=4
