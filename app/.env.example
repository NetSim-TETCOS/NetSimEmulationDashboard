HOST=0.0.0.0
PORT=8080
PUBLIC_HOST=netsimemulation.ddns.net
ALLOWED_ORIGINS=http://netsimemulation.ddns.net:8080,http://localhost:8080
PROBE_INTERVAL_MS=1000
PROBE_TIMEOUT_MS=5000
SESSION_NAME=NetSim Online Emulation Demo
ADMIN_TOKEN=change-me-before-public-use
DATABASE_URL=sqlite:///./netsim_demo.db
MAX_MESSAGE_BYTES=16384
PARTICIPANT_STALE_TIMEOUT_SEC=45
